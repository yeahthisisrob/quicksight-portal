{
  "name": "@quicksight-portal/openapi-codegen",
  "version": "0.0.0",
  "private": true,
  "description": "Validates the OpenAPI contract and generates shared/generated/types.ts and openapi.json",
  "scripts": {
    "contract": "pnpm run lint:schema && pnpm run generate",
    "lint:schema": "redocly lint ../../shared/schemas/api.openapi.yaml --skip-rule operation-4xx-response",
    "generate": "openapi-typescript ../../shared/schemas/api.openapi.yaml -o ../../shared/generated/types.ts && node openapi-json.mjs"
  },
  "devDependencies": {
    "@redocly/cli": "^2.53.3",
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.3.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "5.9.3"
  }
}
