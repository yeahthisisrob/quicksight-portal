{
  "name": "@quicksight-portal/frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:storybook": "node scripts/smoke-stories.mjs",
    "test:storybook:ci": "concurrently -k -s first -n \"SB,SMOKE\" -c \"magenta,blue\" \"pnpm run storybook:ci\" \"wait-on tcp:6006 && pnpm run test:storybook\"",
    "storybook": "storybook dev -p 6006",
    "storybook:ci": "storybook dev -p 6006 --ci",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.22",
    "@aws-sdk/client-sts": "^3.1134.0",
    "@aws-sdk/credential-providers": "^3.1134.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/x-data-grid": "^9.13.0",
    "@mui/x-date-pickers": "^9.13.0",
    "@quicksight-portal/shared": "workspace:*",
    "@scalar/api-reference-react": "^0.9.74",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "date-fns": "^4.4.0",
    "notistack": "^3.0.2",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-onboarding": "^10.6.0",
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "concurrently": "^10.0.5",
    "jsdom": "^30.1.0",
    "playwright": "^1.63.0",
    "storybook": "^10.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^5.0.1",
    "wait-on": "^9.1.0"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
