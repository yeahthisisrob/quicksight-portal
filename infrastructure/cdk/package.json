{
  "name": "@quicksight-portal/cdk",
  "version": "1.0.0",
  "private": true,
  "description": "AWS CDK infrastructure for QuickSight Assets Portal",
  "main": "index.js",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "cdk": "cdk",
    "bootstrap": "cdk bootstrap",
    "synth": "cdk synth",
    "deploy": "cdk deploy --all --require-approval never",
    "destroy": "cdk destroy --all --force",
    "watch": "tsc --noEmit --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "aws-cdk": "^2.1139.0",
    "aws-cdk-lib": "^2.270.0",
    "cdk-nag": "^3.0.2",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "dependencies": {}
}
