{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "backend/lambda": {
      "entry": ["index.ts", "worker.ts", "build.js", "**/__tests__/**/*.test.ts"],
      "project": ["**/*.ts"],
      "ignore": ["dist/**", "coverage/**", "shared/types/raw-imports.ts"]
    },
    "frontend": {
      "entry": [
        "src/main.tsx",
        "src/**/*.stories.tsx",
        "src/**/*.test.{ts,tsx}",
        ".storybook/*.{ts,tsx}",
        "scripts/*.mjs"
      ],
      "project": ["src/**/*.{ts,tsx}", ".storybook/**/*.{ts,tsx}"]
    },
    "infrastructure/cdk": {
      "entry": ["bin/app.ts", "test/**/*.test.ts"],
      "project": ["**/*.ts"],
      "ignore": ["cdk.out/**"]
    },
    "shared": {
      "entry": ["tools/**/*.mjs", "lib/**/*.ts"],
      "project": ["**/*.ts"],
      "ignore": ["generated/**"]
    }
  },
  "ignoreFiles": ["scripts/smus-grant-portal-access.mjs"]
}
