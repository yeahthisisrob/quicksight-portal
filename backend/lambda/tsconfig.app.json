{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "lib": ["ES2022", "DOM"],
    // Type-check only. esbuild (build.js) produces the Lambda bundles, and it
    // wipes dist first, so anything tsc emitted here was thrown away - and
    // racing the bundler for the same directory.
    "noEmit": true,
    "rootDir": "../..",
    "strictPropertyInitialization": true,
    "noPropertyAccessFromIndexSignature": false,
    "exactOptionalPropertyTypes": false,
    "removeComments": true,
    "sourceMap": true,
    "paths": {
      "@shared/*": ["../../shared/*"]
    },
    // Explicit under TypeScript 7: it no longer pulls every @types package
    // into the global scope automatically, so without this every `process`
    // and `node:*` import fails to resolve.
    "types": ["node"]
  },
  "include": ["**/*.ts", "../../shared/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**/*",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ]
}
