{
  "name": "@quicksight-portal/lambda",
  "version": "1.0.0",
  "private": true,
  "description": "QuickSight Portal Lambda - Express-free, pure handlers",
  "main": "index.js",
  "scripts": {
    "build": "pnpm run clean && NODE_ENV=production node build.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "watch": "nodemon",
    "watch:typecheck": "tsc --watch --noEmit",
    "kill-sam": "../../scripts/kill-sam.sh",
    "dev": "pnpm run build && pnpm run kill-sam && cd ../../sam && sam build && sam local start-api --env-vars env.json --port 3000 --host 0.0.0.0 --warm-containers EAGER",
    "dev:debug": "pnpm run build && pnpm run kill-sam && cd ../../sam && sam build && sam local start-api --env-vars env.json --port 3000 --host 0.0.0.0 --debug --warm-containers EAGER"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.35.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1135.0",
    "@aws-sdk/client-cloudtrail": "^3.1135.0",
    "@aws-sdk/client-cloudwatch": "^3.1135.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1135.0",
    "@aws-sdk/client-datazone": "^3.1135.0",
    "@aws-sdk/client-dynamodb": "^3.1135.0",
    "@aws-sdk/client-lambda": "^3.1135.0",
    "@aws-sdk/client-quicksight": "^3.1135.0",
    "@aws-sdk/client-s3": "^3.1135.0",
    "@aws-sdk/client-sqs": "^3.1135.0",
    "@aws-sdk/client-sts": "^3.1135.0",
    "@aws-sdk/credential-providers": "^3.1135.0",
    "@aws-sdk/lib-dynamodb": "^3.1135.0",
    "@quicksight-portal/shared": "workspace:*",
    "@smithy/node-http-handler": "^4.12.1",
    "aws-jwt-verify": "^5.2.1",
    "aws-sdk": "^2.1693.0",
    "date-fns": "^4.4.0",
    "p-limit": "^7.3.1",
    "uuid": "^14.0.2",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^26.6.1",
    "@types/xml2js": "^0.4.14",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.2",
    "nodemon": "^3.1.14",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
