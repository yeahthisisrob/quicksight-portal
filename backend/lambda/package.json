{
  "name": "quicksight-portal-lambda",
  "version": "1.0.0",
  "private": true,
  "description": "QuickSight Portal Lambda - Express-free, pure handlers",
  "main": "index.js",
  "scripts": {
    "build": "npm run lint:fix && npm run typecheck && npm test && npm run clean && NODE_ENV=production node build.js",
    "build:quick": "npm run clean && NODE_ENV=production node build.js",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist",
    "kill-sam": "../../scripts/kill-sam.sh",
    "dev": "npm run build && npm run kill-sam && cd ../../sam && sam build && sam local start-api --env-vars env.json --port 3000 --host 0.0.0.0 --warm-containers EAGER",
    "dev:quick": "npm run build:quick && npm run kill-sam && cd ../../sam && sam build && sam local start-api --env-vars env.json --port 3000 --host 0.0.0.0 --warm-containers EAGER",
    "dev:debug": "npm run build && npm run kill-sam && cd ../../sam && sam build && sam local start-api --env-vars env.json --port 3000 --host 0.0.0.0 --debug --warm-containers EAGER",
    "start": "npm run dev",
    "watch": "nodemon",
    "watch:typecheck": "tsc --watch --noEmit",
    "watch:all": "concurrently \"npm run watch\" \"npm run watch:typecheck\"",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "build:with-coverage": "npm run lint:fix && npm run typecheck && npm run test:coverage && npm run clean && NODE_ENV=production node build.js"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.35.0",
    "@aws-sdk/client-cloudtrail": "^3.1121.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1121.0",
    "@aws-sdk/client-datazone": "^3.1121.0",
    "@aws-sdk/client-dynamodb": "^3.1121.0",
    "@aws-sdk/client-lambda": "^3.1121.0",
    "@aws-sdk/client-quicksight": "^3.1121.0",
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/client-sqs": "^3.1121.0",
    "@aws-sdk/client-sts": "^3.1121.0",
    "@aws-sdk/credential-providers": "^3.1121.0",
    "@aws-sdk/lib-dynamodb": "^3.1121.0",
    "aws-jwt-verify": "^5.2.1",
    "aws-sdk": "^2.1693.0",
    "date-fns": "^4.4.0",
    "node-fetch": "^2.7.0",
    "p-limit": "^3.1.0",
    "uuid": "^14.0.2",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@redocly/cli": "^2.49.0",
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^22.20.1",
    "@types/node-fetch": "^2.6.13",
    "@types/uuid": "^11.0.0",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-prettier": "^5.5.6",
    "nodemon": "^3.1.14",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
