{
  "name": "quicksight-assets-portal",
  "version": "2.14.0",
  "private": true,
  "scripts": {
    "dev": "just dev",
    "check": "biome check .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:coverage": "pnpm -r run test:coverage",
    "build:backend": "pnpm --filter @quicksight-portal/lambda run build",
    "build:frontend": "pnpm --filter @quicksight-portal/frontend run build",
    "generate-types": "pnpm --filter @quicksight-portal/shared run generate",
    "cdk:synth": "pnpm --filter @quicksight-portal/cdk run synth",
    "cdk:diff": "pnpm --filter @quicksight-portal/cdk exec cdk diff",
    "cdk:deploy": "pnpm --filter @quicksight-portal/cdk run deploy",
    "fix": "biome check --write .",
    "verify:architecture": "node scripts/verify-architecture-rules.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=12"
  }
}
