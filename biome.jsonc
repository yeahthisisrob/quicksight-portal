// Biome owns formatting AND linting for the whole repo: one binary, one config.
//
// This replaced Prettier + ESLint (4 config files, 11 dev dependencies, a
// process per package to stay under a 4GB heap, ~40s). Biome does the same work
// in milliseconds because it is a single Rust binary with no TypeScript program
// to build.
//
// The rules that matter most here are the architectural ones, and they live in
// `overrides` at the bottom: Vertical Slice Architecture for the backend
// (the AWS SDK may only be touched by the adapter layer) and Feature-Sliced
// Design for the frontend (a layer may only import from layers below it, and
// only through their public APIs). `biome-plugins/*.grit` carries the one rule
// that needs an AST match rather than a path pattern.
//
// Two rules of thumb decide what earns a place:
//   1. Auto-fixable rules are errors. `just fix` does the work; nobody argues
//      about it in review.
//   2. A rule needing a human to resolve must catch real defects, not assert an
//      arbitrary number. The old metric caps (max-params, max-depth,
//      max-statements, max-nested-callbacks) never caught a bug here and only
//      produced workarounds, so they are gone.
{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  // Respect .gitignore. Without this Biome formats generated and local-only
  // files that no human owns - cdk.context.json is the one that bites: CDK
  // rewrites it on every synth/deploy (it caches lookups like the SMUS domain
  // id), so `just check` would fail on a file nobody edited and `just deploy`
  // could not get past its own preflight.
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },

  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      // Agent scratch space, including stale worktree copies of this repo.
      "!.claude",
      "!**/dist",
      "!**/build",
      "!**/lib",
      "!**/coverage",
      "!**/cdk.out",
      "!**/storybook-static",
      "!**/*.d.ts",
      "!pnpm-lock.yaml",
      "!mise.lock",
      "!CHANGELOG.md",
      "!shared/generated"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        // DEBT (7): React hook dependency arrays that do not match what the
        // hook closes over. Under ESLint these were warnings on a
        // `--max-warnings 50` budget, so they were never enforced.
        "useExhaustiveDependencies": "off",
        "noUnusedVariables": {
          "level": "error",
          "options": {
            "ignoreRestSiblings": true
          }
        },
        "noUnusedImports": "error"
      },
      "style": {
        // DEBT (24): non-null assertions, frontend. ESLint enforced this on the
        // backend only, so the frontend accumulated them unchecked.
        "noNonNullAssertion": "off",
        "useConst": "error",
        "noParameterAssign": "error",
        "useImportType": "error",
        "useExportType": "error",
        "noRestrictedImports": "off"
      },
      "suspicious": {
        "noDoubleEquals": "error",
        "noShadow": "error",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["warn", "error"]
          }
        },
        // Off, deliberately. ~1,450 `any`s, mostly at AWS SDK boundaries.
        "noExplicitAny": "off",

        // DEBT (62): React `key={index}`. Reordering or removing a list item
        // with an index key makes React reuse the wrong DOM node and component
        // state. Real, and needs a per-list correct key rather than a bulk fix.
        "noArrayIndexKey": "off",
        // DEBT (33): callbacks passed to map/filter/reduce/some that do not
        // return on every path. Frequently a genuine bug.
        "useIterableCallbackReturn": "off",
        // DEBT (6): `let x;` with no type and no initialiser, implicitly any.
        "noImplicitAnyLet": "off",
        // DEBT (5): assignment inside an expression.
        "noAssignInExpressions": "off",
        // DEBT (2): identifiers shadowing globals.
        "noShadowRestrictedNames": "off",
        // DEBT (2): `${...}` inside a plain quoted string, usually a missed
        // template literal.
        "noTemplateCurlyInString": "off"
      },
      "complexity": {
        "noForEach": "off",
        // DEBT (15 + 5): `this` in a static context, and classes that contain
        // only static members (a module with extra syntax).
        "noThisInStatic": "off",
        "noStaticOnlyClass": "off"
      }

      // ---------------------------------------------------------------------
      // PRE-EXISTING DEBT - a burn-down list, not a set of opinions.
      //
      // Every rule below is part of Biome's recommended preset and every one of
      // them is finding something real. None of it is a regression from this
      // change: ESLint simply never ran these checks, so the findings have been
      // sitting in the codebase unseen. The counts are from the first clean run.
      //
      // They are off rather than warnings on purpose. A warning that fires 62
      // times on every run is a warning nobody reads, and `--max-warnings 0`
      // would just turn it into a broken build. Fix a category, delete its line,
      // and the rule starts holding the line for good.
      // ---------------------------------------------------------------------
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ":BUN:",
              ":NODE:",
              ":BLANK_LINE:",
              ":PACKAGE:",
              ":BLANK_LINE:",
              ["@/app/**", "@/pages/**", "@/widgets/**", "@/features/**", "@/entities/**"],
              ":BLANK_LINE:",
              ["@/shared/**", "@shared/**"],
              ":BLANK_LINE:",
              [":PATH:", "./**", "../**"]
            ]
          }
        }
      }
    }
  },
  "overrides": [
    // Developer tooling: build scripts, repo scripts, Storybook config and
    // stories. Printing to the console is their interface, not a mistake, and
    // the size/shadow rules are aimed at shipped code.
    {
      "includes": [
        "backend/lambda/build.js",
        "scripts/**",
        "frontend/scripts/**",
        "frontend/.storybook/**",
        "**/*.stories.ts",
        "**/*.stories.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": { "noConsole": "off", "noShadow": "off" },
          "style": { "noMagicNumbers": "off", "noExcessiveLinesPerFile": "off" }
        }
      }
    },
    // Backend: Vertical Slice Architecture. The adapter layer is the only place the raw
    // QuickSight SDK may be touched, and QuickSightService is the only sanctioned caller of
    // QuickSightAdapter.
    {
      "includes": ["backend/lambda/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "useReadonlyClassProperties": "error",
            "useConsistentMemberAccessibility": {
              "level": "error",
              "options": {
                "accessibility": "explicit"
              }
            },
            "noMagicNumbers": "error",
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 2000
              }
            },
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@aws-sdk/client-quicksight"],
                    "message": "Do not import @aws-sdk/client-quicksight directly. Use shared/types/aws-sdk-types.ts for types, or QuickSightAdapter for SDK operations."
                  },
                  {
                    "group": ["**/adapters/aws/QuickSightAdapter"],
                    "message": "Do not import QuickSightAdapter directly. Use QuickSightService for QuickSight operations."
                  }
                ]
              }
            }
          },
          "suspicious": {
            "noImportCycles": "error",
            "useAwait": "error"
          }
        }
      },
      "plugins": ["./biome-plugins/no-unref.grit"]
    },
    // Constants and config files exist to hold the literals.
    {
      "includes": ["backend/lambda/**/constants/**/*.ts", "backend/lambda/**/config/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noMagicNumbers": "off"
          }
        }
      }
    },
    // The adapter layer is where the raw SDK belongs.
    {
      "includes": [
        "backend/lambda/adapters/aws/*.ts",
        "backend/lambda/shared/types/aws-sdk-types.ts",
        "backend/lambda/shared/config/awsClients.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    // QuickSightService may use the adapter; it still may not reach the SDK.
    {
      "includes": ["backend/lambda/shared/services/aws/QuickSightService.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@aws-sdk/client-quicksight"],
                    "message": "Do not import @aws-sdk/client-quicksight directly. Use shared/types/aws-sdk-types.ts for types."
                  }
                ]
              }
            }
          }
        }
      }
    },
    // FSD: pages may use widgets/features/entities/shared, never app or another page, and only
    // public APIs of lower slices.
    {
      "includes": ["frontend/src/pages/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**"],
                    "message": "pages may not import from app (higher layer)."
                  },
                  {
                    "group": ["@/pages/**"],
                    "message": "Cross-imports between pages are not allowed. Extract shared logic to widgets or features."
                  },
                  {
                    "group": [
                      "@/features/*/lib/**",
                      "@/features/*/model/**",
                      "@/features/*/api/**",
                      "@/features/*/ui/**",
                      "@/features/*/utils/**"
                    ],
                    "message": "Import the feature public API, not internal modules."
                  },
                  {
                    "group": ["@/entities/*/model/**", "@/entities/*/lib/**", "@/entities/*/ui/**"],
                    "message": "Import the entity public API, not internal modules."
                  }
                ]
              }
            }
          }
        }
      }
    },
    // FSD: widgets may use features/entities/shared.
    {
      "includes": ["frontend/src/widgets/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**", "@/pages/**"],
                    "message": "widgets may not import from app or pages (higher layers)."
                  },
                  {
                    "group": ["@/widgets/**"],
                    "message": "Cross-imports between widget slices are not allowed. Merge the slices, move shared code down a layer, or compose at the page level."
                  },
                  {
                    "group": [
                      "@/features/*/lib/**",
                      "@/features/*/model/**",
                      "@/features/*/api/**",
                      "@/features/*/ui/**",
                      "@/features/*/utils/**"
                    ],
                    "message": "Import the feature public API, not internal modules."
                  },
                  {
                    "group": ["@/entities/*/model/**", "@/entities/*/lib/**", "@/entities/*/ui/**"],
                    "message": "Import the entity public API, not internal modules."
                  }
                ]
              }
            }
          }
        }
      }
    },
    // FSD: features may use entities/shared.
    {
      "includes": ["frontend/src/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**", "@/pages/**", "@/widgets/**"],
                    "message": "features may not import from app, pages or widgets (higher layers)."
                  },
                  {
                    "group": ["@/features/**"],
                    "message": "Cross-imports between feature slices are not allowed. Move shared code to entities/shared, or compose at the widget/page level (e.g. via a slot prop)."
                  },
                  {
                    "group": ["@/entities/*/model/**", "@/entities/*/lib/**", "@/entities/*/ui/**"],
                    "message": "Import the entity public API, not internal modules."
                  }
                ]
              }
            }
          }
        }
      }
    },
    // FSD: entities may use shared only.
    {
      "includes": ["frontend/src/entities/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**", "@/pages/**", "@/widgets/**", "@/features/**"],
                    "message": "entities may not import from app, pages, widgets or features (higher layers)."
                  },
                  {
                    "group": ["@/entities/**"],
                    "message": "Cross-imports between entity slices are not allowed. Use relative paths within a slice; move shared code to shared."
                  }
                ]
              }
            }
          }
        }
      }
    },
    // FSD: shared is the bottom layer and may import nothing above it.
    {
      "includes": ["frontend/src/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app/**",
                      "@/pages/**",
                      "@/widgets/**",
                      "@/features/**",
                      "@/entities/**"
                    ],
                    "message": "shared is the bottom layer and may not import from any layer above it."
                  }
                ]
              }
            }
          }
        }
      }
    },
    // CDK constructs are instantiated for their effect on the stack.
    {
      "includes": ["infrastructure/cdk/**/*.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "error"
          }
        }
      }
    },
    // Tests reach past public APIs on purpose, to mock and to assert.
    {
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off",
            "noMagicNumbers": "off",
            "noNonNullAssertion": "off",
            "noExcessiveLinesPerFile": "off"
          },
          "complexity": {
            // Tests read private/protected members via obj['name'] on purpose -
            // it is the only way TypeScript allows it. Rewriting those to dot
            // access (the rule's "fix") makes the test files stop compiling.
            "useLiteralKeys": "off",
            // A mocked constructor must be a function expression: arrows have
            // no [[Construct]] slot, so `new Service()` throws
            // "... is not a constructor" under vitest 4+. This rule rewrites
            // those function expressions back into arrows on every format,
            // silently breaking 177 tests.
            "useArrowFunction": "off"
          },
          "suspicious": {
            "noConsole": "off",
            "useAwait": "off"
          },
          "correctness": {
            // `expect(a?.b?.c as T)` is idiomatic in these assertions.
            "noUnsafeOptionalChaining": "off"
          }
        }
      }
    },
    {
      // DEBT: CacheWriter is 2,312 lines, over the 2,000 cap. Splitting it is
      // its own change; exempting the one file keeps the cap meaningful for
      // every other file instead of raising it for all of them.
      "includes": ["backend/lambda/shared/services/cache/CacheWriter.ts"],
      "linter": { "rules": { "style": { "noExcessiveLinesPerFile": "off" } } }
    }
  ]
}
