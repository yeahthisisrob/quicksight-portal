# pnpm's strict node_modules is the point: a package may only import what it
# declares, so phantom dependencies fail here instead of in a Lambda cold start.
hoist=false
strict-peer-dependencies=false

# Bundlers (esbuild, vite) resolve through symlinks fine; keep them real so
# pnpm can dedupe the store.
node-linker=isolated

# Matches the engines field; a mismatched Node fails the install rather than
# producing a subtly different tree.
engine-strict=true
